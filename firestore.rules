rules_version = '2';

// Janazah app - Phase 1 security rules.
//
// These rules are the only enforcement layer in this phase. There is no server
// code, so anything not forbidden here is permitted to any browser on the
// internet holding the (public, non-secret) Firebase web config.
//
// Two invariants matter most:
//   1. A /notices document is world-readable once published. Its key set is
//      therefore restricted to an explicit allowlist so that a private field
//      cannot physically be written onto it, even by a bug in the admin UI.
//      Anything private lives in /notices/{id}/private/*, which is staff-only.
//   2. Only staff of a *verified* organization can publish. Verification
//      status is writable by platform admins only, so an organization cannot
//      verify itself.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(uid()));
    }

    function orgData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function orgExists(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId));
    }

    function isOrgStaff(orgId) {
      return isSignedIn() && orgExists(orgId) && uid() in orgData(orgId).staffUids;
    }

    function isOrgOwner(orgId) {
      return isSignedIn() && orgExists(orgId) && orgData(orgId).ownerUid == uid();
    }

    function isOrgVerified(orgId) {
      return orgExists(orgId) && orgData(orgId).verificationStatus == 'verified';
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ---------- platform admins ----------
    // A user may check whether they themselves are an admin (learning nothing
    // about anyone else). Nobody may write this collection from a client; the
    // first admin is created by hand in the Firebase console.

    match /admins/{adminUid} {
      allow get: if isSignedIn() && uid() == adminUid;
      allow list: if isPlatformAdmin();
      allow write: if false;
    }

    // ---------- organizations ----------

    function orgKeys() {
      return ['name', 'type', 'address', 'city', 'province', 'postalCode',
              'country',
              'lat', 'lng', 'cell', 'contactEmail', 'phone', 'website',
              'verificationStatus', 'statusReason', 'verifiedAt', 'verifiedBy',
              'ownerUid', 'staffUids', 'createdAt', 'createdBy', 'updatedAt',
              'updatedBy'];
    }

    function orgRequiredKeys() {
      return ['name', 'type', 'address', 'city', 'province', 'lat', 'lng',
              'cell', 'verificationStatus', 'ownerUid', 'staffUids',
              'createdAt', 'createdBy'];
    }

    function validOrgShape() {
      return request.resource.data.keys().hasOnly(orgKeys())
        && request.resource.data.keys().hasAll(orgRequiredKeys())
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 140
        && request.resource.data.type in ['masjid', 'funeral_home', 'other']
        // needs_information sits alongside pending: still unverified, still
        // unable to publish, but distinguishable so an applicant is told
        // there is something for them to do rather than being left to
        // assume nobody has looked.
        && request.resource.data.verificationStatus
             in ['pending', 'needs_information', 'verified', 'rejected',
                 'suspended']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.staffUids is list
        && request.resource.data.staffUids.size() <= 50;
    }

    // Who made this change, when the writer chose to say.
    //
    // Optional, so every existing writer keeps working, and pinned to the
    // authenticated caller when present, so it is worth something. The
    // organization document has no lastEditedBy of its own, which meant a
    // staff removal or a profile edit reached the audit trail with no actor
    // at all: a record that something happened and nobody did it. This is
    // what the audit trigger reads to name the account responsible.
    function pinnedUpdatedBy() {
      return !('updatedBy' in request.resource.data)
        || request.resource.data.updatedBy == uid();
    }

    match /organizations/{orgId} {
      // Verified organizations are publicly readable: the community feed needs
      // masjid names and prayer locations. Unverified ones are visible only to
      // their own staff and to platform admins.
      allow get: if resource.data.verificationStatus == 'verified'
                 || isOrgStaff(orgId)
                 || isPlatformAdmin();
      // For list, Firestore matches the rule against the query's filters, so a
      // caller must constrain the query to something a clause here permits:
      // where('verificationStatus','==','verified') for the public directory,
      // or where('staffUids','array-contains', <own uid>) for "my
      // organizations", which must work while still pending verification.
      allow list: if resource.data.verificationStatus == 'verified'
                  || (isSignedIn() && uid() in resource.data.staffUids)
                  || isPlatformAdmin();

      // Anyone signed in may register an organization, but only as pending,
      // owned by themselves, with themselves as the sole staff member.
      allow create: if isSignedIn()
        && validOrgShape()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.createdBy == uid()
        && request.resource.data.staffUids == [uid()]
        && request.resource.data.verificationStatus == 'pending'
        && !('verifiedAt' in request.resource.data)
        && !('verifiedBy' in request.resource.data);

      // Platform admin: may change verification status and nothing structural.
      // verifiedBy, when it changes at all, must name the admin making the
      // change: this is what lets the server-written audit trail attribute a
      // verification decision to a real account rather than trusting whatever
      // the client happened to send.
      allow update: if isPlatformAdmin()
        && validOrgShape()
        && pinnedUpdatedBy()
        && !changed(['ownerUid', 'createdAt', 'createdBy'])
        && (request.resource.data.get('verifiedBy', null) == resource.data.get('verifiedBy', null)
            || request.resource.data.verifiedBy == uid());

      // Owner: may edit the profile and manage staff, never the status.
      allow update: if isOrgOwner(orgId)
        && validOrgShape()
        && pinnedUpdatedBy()
        && !changed(['verificationStatus', 'verifiedAt', 'verifiedBy',
                     'statusReason', 'ownerUid', 'createdAt', 'createdBy']);

      // Non-owner staff: profile edits only, no staff list changes.
      allow update: if isOrgStaff(orgId)
        && validOrgShape()
        && pinnedUpdatedBy()
        && !changed(['verificationStatus', 'verifiedAt', 'verifiedBy',
                     'statusReason', 'ownerUid', 'staffUids', 'createdAt',
                     'createdBy']);

      // Organizations are suspended, never deleted: the audit trail must keep
      // pointing at something. The one exception is sample data, which a
      // platform administrator adds and removes from the admin portal. The
      // `sample-` id prefix is what makes the exception safe: it can only
      // ever match a record this platform created for testing, never a real
      // masjid, whose id is a Firestore-generated one.
      allow delete: if isPlatformAdmin() && orgId.matches('^sample-.*');
      allow delete: if false;

      // ---------- staff join requests ----------
      match /staffRequests/{requestUid} {
        allow create: if isSignedIn()
          && requestUid == uid()
          && request.resource.data.keys().hasOnly(
               ['uid', 'email', 'displayName', 'status', 'requestedAt',
                'decidedAt', 'decidedBy'])
          && request.resource.data.uid == uid()
          && request.resource.data.status == 'pending';
        allow get: if isSignedIn()
          && (uid() == requestUid || isOrgStaff(orgId) || isPlatformAdmin());
        allow list: if isOrgStaff(orgId) || isPlatformAdmin();
        // decidedBy must name whoever is actually deciding, for the same reason
        // verifiedBy is pinned above: the audit trail attributes this to the
        // account in the document, and that has to be trustworthy.
        allow update: if (isOrgOwner(orgId) || isPlatformAdmin())
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == uid();
        allow delete: if isOrgOwner(orgId) || uid() == requestUid;
      }

      // ---------- verification application ----------
      //
      // Everything the platform collects to satisfy itself that the person
      // registering really represents this organization. It lives here, and
      // never on the organization document, for one concrete reason: a
      // verified organization is world-readable (see `allow get` above), so a
      // field added there becomes public the moment an admin approves it.
      // The applicant's name, personal address, work email, phone number and
      // written explanation are none of the public's business, before or
      // after approval.
      //
      // Two documents, with deliberately different audiences:
      //   application/submitted - written by the applicant, read by admins.
      //   application/review    - internal admin notes. The applicant cannot
      //                           read these, so a reviewer can write frankly.
      //
      // Nobody else reaches either one: not the community, not other
      // organizations, not an anonymous visitor, not a non-owner staff member
      // who was added to the org later.

      function applicationKeys() {
        return ['applicantName', 'applicantRole', 'applicantRoleOther',
                'applicantEmail', 'workEmail', 'phone', 'roleExplanation',
                'authorized', 'verificationMethods', 'staffPageUrl',
                'documentPath', 'documentName', 'emailVerifiedAtSubmit',
                'submittedAt', 'submittedBy', 'updatedAt'];
      }

      function validApplicationShape() {
        return request.resource.data.keys().hasOnly(applicationKeys())
          && request.resource.data.keys().hasAll(
               ['applicantName', 'applicantRole', 'applicantEmail',
                'authorized', 'submittedBy', 'emailVerifiedAtSubmit'])
          && request.resource.data.applicantName is string
          && request.resource.data.applicantName.size() > 0
          && request.resource.data.applicantName.size() <= 140
          && request.resource.data.applicantRole is string
          && request.resource.data.applicantEmail is string
          // The authorization declaration is the point of the checkbox. A
          // submission that does not carry it is not a submission.
          && request.resource.data.authorized == true
          && request.resource.data.submittedBy == uid()
          // Pinned to the token rather than trusted from the browser. The
          // reviewer's panel shows "sign-in email confirmed" from this, and a
          // signal a client could set to true itself would be worth nothing.
          // It is also kept deliberately separate from organization
          // verification: owning an inbox says nothing about running a masjid.
          && request.resource.data.emailVerifiedAtSubmit
               == request.auth.token.get('email_verified', false)
          // Optional fields, read through get() so that leaving one out is
          // a valid submission rather than a rule evaluation error.
          && request.resource.data.get('roleExplanation', '').size() <= 2000
          && request.resource.data.get('verificationMethods', []) is list
          && request.resource.data.get('verificationMethods', []).size() <= 10;
      }

      match /application/{docId} {
        // The applicant sees only their own submission, and only for the
        // organization they own. Internal review notes are admin-only.
        allow get: if isPlatformAdmin()
          || (docId == 'submitted' && isOrgOwner(orgId));
        allow list: if isPlatformAdmin();

        // The applicant may write their submission and correct it later,
        // which is what "Request more information" asks them to do. They can
        // never write the review notes.
        allow create, update: if docId == 'submitted'
          && isOrgOwner(orgId)
          && validApplicationShape();

        // Review notes: admins only, and the author is pinned to the account
        // making the write for the same reason verifiedBy is.
        allow create, update: if docId == 'review'
          && isPlatformAdmin()
          && request.resource.data.keys().hasOnly(
               ['notes', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == uid();

        // A verification record is evidence. It is not deleted from a client.
        allow delete: if false;
      }
    }

    // ---------- notices ----------
    //
    // The public document. Its key set is an allowlist. Family phone numbers,
    // internal notes and anything else private have no permitted key here and
    // are rejected at write time rather than merely hidden at read time.

    function noticePublicKeys() {
      return ['orgId', 'orgName', 'orgType', 'status', 'isPublic',
              'deceasedName', 'showDeceasedName',
              'janazahAt', 'timeZone', 'timeLabel',
              'prayerLocation', 'burialLocation', 'instructions',
              'version', 'createdBy', 'createdAt', 'updatedAt',
              'lastEditedBy', 'publishedAt', 'cancelledAt', 'cancelReason',
              'correctionNote', 'redactedAt'];
    }

    function noticeRequiredKeys() {
      return ['orgId', 'status', 'isPublic', 'janazahAt', 'timeZone',
              'prayerLocation', 'version', 'createdBy', 'createdAt'];
    }

    function validPrayerLocation() {
      return request.resource.data.prayerLocation.keys()
               .hasOnly(['name', 'address', 'lat', 'lng', 'cell'])
        && request.resource.data.prayerLocation.keys()
             .hasAll(['name', 'address', 'lat', 'lng', 'cell'])
        && request.resource.data.prayerLocation.lat is number
        && request.resource.data.prayerLocation.lng is number;
    }

    function validBurialLocation() {
      return !('burialLocation' in request.resource.data)
        || request.resource.data.burialLocation == null
        || request.resource.data.burialLocation.keys()
             .hasOnly(['name', 'address', 'lat', 'lng']);
    }

    function validNoticeShape() {
      return request.resource.data.keys().hasOnly(noticePublicKeys())
        && request.resource.data.keys().hasAll(noticeRequiredKeys())
        && request.resource.data.status in ['draft', 'published', 'cancelled']
        && request.resource.data.isPublic ==
             (request.resource.data.status in ['published', 'cancelled'])
        && request.resource.data.orgId is string
        && request.resource.data.janazahAt is timestamp
        && request.resource.data.timeZone is string
        && request.resource.data.version is int
        && validPrayerLocation()
        && validBurialLocation()
        && (!('instructions' in request.resource.data)
            || (request.resource.data.instructions is string
                && request.resource.data.instructions.size() <= 2000))
        && (!('deceasedName' in request.resource.data)
            || request.resource.data.deceasedName == null
            || (request.resource.data.deceasedName is string
                && request.resource.data.deceasedName.size() <= 140));
    }

    match /notices/{noticeId} {
      // Published and cancelled notices are public. Cancelled stays readable
      // so that someone holding a shared link sees the cancellation rather
      // than a dead page. Drafts are staff-only.
      //
      // Note for the feed: for a list, Firestore evaluates the rule against
      // the query's filters rather than the returned documents, so an
      // unauthenticated caller MUST include where('isPublic','==',true).
      // An unfiltered list is rejected. isPublic is a denormalised mirror of
      // status, kept honest by validNoticeShape() below, because rule/query
      // matching handles plain equality and not an `in` over a list.
      allow get: if resource.data.isPublic == true
                 || isOrgStaff(resource.data.orgId)
                 || isPlatformAdmin();
      allow list: if resource.data.isPublic == true
                  || isOrgStaff(resource.data.orgId)
                  || isPlatformAdmin();

      allow create: if isSignedIn()
        && validNoticeShape()
        && isOrgStaff(request.resource.data.orgId)
        && isOrgVerified(request.resource.data.orgId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.version == 1
        && request.resource.data.status in ['draft', 'published'];

      // Corrections and cancellations by the publishing organization.
      // Cancellation is terminal. Ownership fields are immutable. The version
      // counter must advance by exactly one, which makes a lost update
      // visible rather than silent.
      allow update: if validNoticeShape()
        && isOrgStaff(resource.data.orgId)
        && isOrgVerified(resource.data.orgId)
        && resource.data.status != 'cancelled'
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.lastEditedBy == uid();

      // Platform admin takedown of a fraudulent or incorrect notice.
      allow update: if isPlatformAdmin()
        && validNoticeShape()
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status == 'cancelled'
        && request.resource.data.version == resource.data.version + 1;

      // Platform admin correction, and hiding a notice without cancelling it.
      //
      // Additive to the takedown clause above rather than a loosening of it,
      // and narrower on every axis except the one it exists for. It cannot
      // touch a cancelled notice, cannot produce a cancelled notice
      // (cancellation stays the takedown path, and stays terminal), cannot
      // move a notice between organizations or rewrite its authorship, and
      // unlike the takedown clause it forces the editing administrator to
      // name themselves, so the audit trail attributes the change to a real
      // account.
      //
      // Without it, an administrator holding a notice with a wrong time or a
      // wrong address has exactly one remedy available: cancel a real funeral
      // notice outright, irreversibly, and tell the community it is off.
      // Pulling it back to a draft while the masjid is asked what the correct
      // time is, then publishing it again, is the smaller action, and hiding
      // it that way reuses the status the app already has rather than
      // inventing a second, parallel notion of hidden.
      allow update: if isPlatformAdmin()
        && validNoticeShape()
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status != 'cancelled'
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.lastEditedBy == uid();

      // Never hard-delete a published notice; cancel it. Deleting would break
      // the audit trail and leave shared links dead instead of corrected.
      // Sample notices are the exception, for the same reason as sample
      // organizations above: the `sample-` prefix cannot match a real notice,
      // and testing data has to be removable in full.
      allow delete: if isPlatformAdmin() && noticeId.matches('^sample-.*');
      allow delete: if isOrgStaff(resource.data.orgId)
        && resource.data.status == 'draft';

      // ---------- private side of a notice ----------
      // Family contacts, internal coordination notes. Never public, and
      // structurally unable to reach the public document above.
      match /private/{docId} {
        allow read, write: if isPlatformAdmin()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/notices/$(noticeId))
              && isOrgStaff(
                   get(/databases/$(database)/documents/notices/$(noticeId))
                     .data.orgId));
      }
    }

    // ---------- audit log ----------
    // Append-only. No update, no delete, by anyone, ever. actorUid is forced
    // to the authenticated caller so an entry cannot be written under someone
    // else's name, and `at` is forced to server time so it cannot be backdated.

    match /auditLog/{entryId} {
      allow get, list: if isPlatformAdmin()
        || (isSignedIn() && resource.data.orgId != null
            && isOrgStaff(resource.data.orgId));

      // Written only by Cloud Functions triggers through the Admin SDK, which
      // bypasses rules, so that an entry cannot be skipped by whichever client
      // action should have produced it. See functions/index.js and
      // functions/lib/audit-log.js. No client, staff or admin included, may
      // write here at all.
      allow create, update, delete: if false;
    }

    // ---------- reports ----------
    // Community members flag an incorrect or fraudulent notice. A reporter can
    // file but cannot read the queue; only platform admins triage.

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['noticeId', 'reportedBy', 'reason', 'detail', 'status',
              'createdAt', 'resolvedBy', 'resolvedAt', 'resolution'])
        && request.resource.data.keys().hasAll(
             ['noticeId', 'reportedBy', 'reason', 'status', 'createdAt'])
        && request.resource.data.reportedBy == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 60
        && (!('detail' in request.resource.data)
            || request.resource.data.detail.size() <= 1000);
      allow get, list: if isPlatformAdmin();
      // Triage only: an administrator resolves or dismisses a report, and
      // cannot rewrite what was reported or who reported it.
      allow update: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(
             ['noticeId', 'reportedBy', 'reason', 'detail', 'status',
              'createdAt', 'resolvedBy', 'resolvedAt', 'resolution'])
        && request.resource.data.noticeId == resource.data.noticeId
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['open', 'resolved', 'dismissed']
        && request.resource.data.resolvedBy == uid();
      allow delete: if false;
    }

    // ---------- email preferences ----------
    //
    // A person's own opt-in record for email, keyed to whatever auth uid
    // their browser currently holds. Ta'ziyah keeps no user document (see
    // account.js), and this is a narrow, deliberate exception to that: an
    // email address, held only for someone who chose to give one, reachable
    // only by the uid that gave it. It reuses the same identity /reports
    // already keys to (an anonymous Firebase Auth session when there is no
    // account), rather than inventing a second notion of "who this is".
    //
    // The document not existing is itself meaningful: nothing here defaults
    // to sending mail, so absence must read as "send nothing", never as
    // "send everything". That is enforced in the functions that read this
    // collection, not by a rule, but the shape below keeps the one field a
    // sender would need to promise (email) mandatory whenever this exists at
    // all.

    function emailPreferencesKeys() {
      return ['email', 'followedMasjidPosts', 'noticeUpdates', 'nearbyAlerts',
              'updatedAt', 'updatedBy'];
    }

    function validEmailPreferencesShape() {
      return request.resource.data.keys().hasOnly(emailPreferencesKeys())
        && request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        // Long enough for any real address, short enough that this can never
        // become a place to stash something other than an email address.
        && request.resource.data.email.size() <= 254
        && (!('followedMasjidPosts' in request.resource.data)
            || request.resource.data.followedMasjidPosts is bool)
        && (!('noticeUpdates' in request.resource.data)
            || request.resource.data.noticeUpdates is bool)
        && (!('nearbyAlerts' in request.resource.data)
            || request.resource.data.nearbyAlerts is bool);
    }

    match /emailPreferences/{prefUid} {
      // Only the person this document is about, ever. Not even a platform
      // admin: there is no support workflow built on this collection, and
      // giving one an easy path to read email addresses would undo the
      // point of keeping them out of every other document.
      allow get: if isSignedIn() && uid() == prefUid;
      // Nobody enumerates this collection. A list query would either be
      // scoped to nothing useful or, unscoped, would be every address on the
      // platform.
      allow list: if false;
      allow create, update: if isSignedIn() && uid() == prefUid
        && validEmailPreferencesShape()
        && pinnedUpdatedBy();
      // Turning off every category and deleting the record amount to the
      // same thing, so both are offered: withdrawing consent removes the
      // address rather than leaving it stored with everything unchecked.
      allow delete: if isSignedIn() && uid() == prefUid;
    }

    // ---------- platform settings ----------
    //
    // Small operational switches a platform administrator flips from the
    // admin portal. Publicly readable because the app has to know, before
    // anyone signs in, whether it is showing sample data and whether there is
    // an announcement to display; there is nothing here worth hiding, and
    // nothing about any person.
    //
    // Exactly two documents are writable, each with its own closed field
    // allowlist and its own type and range checks. This is deliberately not a
    // free-form settings document: a platform administrator can change what
    // the app does, but only along the axes named here, and only within the
    // bounds named here. Nothing in either document is a secret, a credential,
    // or a security control: none of it decides who may read or write
    // anything, so a wrong value is a bad configuration and never a breach.
    //
    //   sampleData  the pre-existing switch for the fictional demo records.
    //   platform    everything the admin portal's Platform Settings section
    //               edits, written whole so a partial write cannot leave the
    //               document half-typed.

    function validSampleDataSetting() {
      return request.resource.data.keys().hasOnly(['enabled', 'updatedAt', 'updatedBy'])
        && request.resource.data.enabled is bool;
    }

    function validPlatformSettings() {
      return request.resource.data.keys().hasOnly(
             ['notificationRadiusKm', 'reminderMinutes', 'organizationTypes',
              'supportEmail', 'privacyEmail',
              'optionalDeceasedName', 'optionalBurialLocation',
              'optionalInstructions',
              'announcementEnabled', 'announcementMessage',
              'updatedAt', 'updatedBy'])
        // Every field is required as well as allowed: the settings form always
        // sends the whole document, so a write missing one of these is a
        // malformed write rather than a partial edit worth honouring.
        && request.resource.data.notificationRadiusKm is number
        && request.resource.data.notificationRadiusKm >= 1
        && request.resource.data.notificationRadiusKm <= 200
        && request.resource.data.reminderMinutes is int
        && request.resource.data.reminderMinutes >= 0
        && request.resource.data.reminderMinutes <= 2880
        && request.resource.data.organizationTypes is list
        && request.resource.data.organizationTypes.size() >= 1
        && request.resource.data.organizationTypes.size() <= 3
        // Mirrors the enum in validOrgShape(): a type offered on the
        // registration form that the organization rule would then reject is
        // a dead end for whoever picks it.
        && request.resource.data.organizationTypes
             .hasOnly(['masjid', 'funeral_home', 'other'])
        && request.resource.data.supportEmail is string
        && request.resource.data.supportEmail.size() <= 120
        && request.resource.data.privacyEmail is string
        && request.resource.data.privacyEmail.size() <= 120
        && request.resource.data.optionalDeceasedName is bool
        && request.resource.data.optionalBurialLocation is bool
        && request.resource.data.optionalInstructions is bool
        && request.resource.data.announcementEnabled is bool
        // Bounded hard. This string is shown to every visitor, so it is a
        // short notice and not a place to publish a document.
        && request.resource.data.announcementMessage is string
        && request.resource.data.announcementMessage.size() <= 280;
    }

    match /platformSettings/{key} {
      allow get: if true;
      allow list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
        && request.resource.data.updatedBy == uid()
        && ((key == 'sampleData' && validSampleDataSetting())
            || (key == 'platform' && validPlatformSettings()));
      allow delete: if false;
    }

    // ---------- notification bookkeeping ----------
    // Written only by the notification function through the Admin SDK, which
    // bypasses rules. Closed to every client: it is internal delivery state,
    // and it is kept in its own collection so it cannot disturb the field
    // allowlist that guards the public notice document.

    match /notificationRuns/{runId} {
      allow read, write: if false;
    }

    // Per-organization notification budget, maintained by the notification
    // function. Closed to clients so it cannot be reset to dodge the limit.
    match /orgNotificationRates/{orgId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
